;; workspace.edn — Polylith ワークスペース設定
;;
;; 配布形態:
;;   - development project のみ有効
;;   - 最初の project を作ったら :projects に追加

{:top-namespace "myorg.myapp"          ; TODO: 実プロジェクトの名前空間プレフィックスに変更（例: "gugenkoubou.billing"）
 :interface-ns  "interface"

 :dialects      ["clj"]                ; poly ツールが読み取るソース方言（"clj"/"cljs"、.cljc は常に対象）

 :default-profile-name "default"       ; poly がデフォルトで development に merge する profile

 :projects
 {"development" {:alias "dev"}
  ;; 最初の project を作ったら追加（<deploy> は DESIGN.md §8.2 で定めた project 名）:
  ;; "<deploy>" {:alias "<deploy>"}
  ;; 複数デプロイ単位がある場合は複数追加:
  ;; "<deploy1>" {:alias "<deploy1>"}
  ;; "<deploy2>" {:alias "<deploy2>"}
  }

 :vcs
 {:name "git"
  :auto-add true}

 :tag-patterns
 {:stable  "^stable-.*"    ; CI 通過時に打つ安定タグ（poly test の影響範囲判定に使われる）
  :release "^v[0-9].*"}    ; 本番リリースタグ

 :compact-views #{}}
