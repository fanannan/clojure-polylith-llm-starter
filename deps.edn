;; deps.edn (workspace ルート = development project)
;;
;; 技術構成:
;;   - 必須層（本ファイルの :deps および必須エイリアス）: Clojure + tools.deps + Polylith + Malli + clj-kondo + cljfmt。
;;     全プロジェクトで常に採用、入れ替え不可
;;   - 追加ライブラリ: 各 brick (base / component) の deps.edn に書く
;;     （Polylith の構造: 本番ビルドは brick の deps.edn から依存解決される）
;;
;; 技術選定:
;;   HTTP、永続化、ライフサイクル管理など、必要な機能カテゴリごとに選ぶ。
;;   選定論理と推奨ライブラリカタログは .llm/guide/STACK_GUIDE.md を参照。
;;
;; 本ファイルの役割:
;;   - 必須層の依存宣言
;;   - REPL 駆動開発（:dev）、Polylith（:poly）、lint（:lint）、format（:format）、
;;     依存更新確認（:outdated）、nREPL（:nrepl）の運用エイリアス
;;   - テスト実行は Polylith の `clj -M:poly test` / `clj -M:poly test :all` で行う
;;   - 本ファイルには本番ライブラリ依存は書かない（brick の deps.edn が一次情報源）
;;
;; 依存追加・変更は CLAUDE.md §2 により人間承認必須。
;;
;; 主要コマンド:
;;   clj -M:dev:nrepl               REPL 起動
;;   clj -M:poly test :all          **推奨の完了条件**（Polylith の影響範囲判定 + 全 brick/project テスト）
;;   clj -M:lint                    clj-kondo
;;   clj -M:format check / fix      cljfmt
;;   clj -M:poly check              Polylith 構造検証
;;   clj -M:poly info               workspace 状態
;;   clj -M:poly test               変更影響範囲テスト（stable タグからの diff、日常作業中に使う）
;;   clj -M:poly create component name:foo
;;   clj -M:outdated                依存最新化チェック
;;
;; 完了条件（CLAUDE.md §5.5）の「全テスト」は clj -M:poly test :all を指す。

{;; development project はソースを直接持たない。各 brick を :dev の :extra-paths で読み込む
 :paths []

 ;; -----------------------------------------------------------------
 ;; 必須層（全プロジェクトで採用）
 ;; -----------------------------------------------------------------
 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}

  ;; Malli — §1.1.1 全域性の実装（境界契約、m/=>、instrumentation の基盤）
  metosin/malli       {:mvn/version "0.16.4"}}

 :aliases
 {;; ----------------------------------------------------------------
  ;; :dev — REPL 駆動開発
  ;;   全 brick を統合 REPL に取り込む構成。以下の 2 つが必要:
  ;;     1. :extra-paths に brick のソースパスを追加 → REPL で namespace を読める
  ;;     2. :extra-deps に brick を :local/root で登録 → brick deps.edn の依存を解決
  ;;   brick deps.edn が一次情報源。
  ;;   tools.deps は :extra-paths からソースを読むが各 brick の deps.edn を自動解決しない。
  ;;   :local/root で brick を依存登録して初めて推移的解決が動く。
  ;; ----------------------------------------------------------------
  :dev
  {:extra-paths
   ["development/src"
    ;; 最初の brick を作ったらここに追加:
    ;; "components/<n>/src" "components/<n>/resources" "components/<n>/test"
    ;; "bases/<n>/src"      "bases/<n>/resources"      "bases/<n>/test"
    ;; 最初の project を作ったらここも追加（config.edn を io/resource で読むため）:
    ;; "projects/<deploy>/resources"
    ]

   :extra-deps
   {;; tools.namespace — (reset) によるコードリロード。どの Clojure プロジェクトでも必要
    org.clojure/tools.namespace {:mvn/version "1.5.0"}

    ;; 最初の brick を作ったらここに brick を :local/root で登録する:
    ;;   poly/<domain> {:local/root "components/<domain>"}
    ;;   poly/<entry>  {:local/root "bases/<entry>"}
    ;; これにより brick deps.edn の :deps が推移的解決される。
    ;;
    ;; 開発支援ライブラリを採用する場合、以下も追加:
    ;;   djblue/portal                {:mvn/version "0.58.5"}
    ;;   org.clojure/test.check       {:mvn/version "1.1.1"}
    ;;   nubank/matcher-combinators   {:mvn/version "3.9.1"}
    ;; ライフサイクル管理の REPL 補助を採用する場合:
    ;;   integrant/repl               {:mvn/version "0.4.0"}
    }

   :jvm-opts
   ["-XX:-OmitStackTraceInFastThrow"
    "-Dclojure.compiler.direct-linking=false"]}

  ;; ----------------------------------------------------------------
  ;; :nrepl — エディタ接続用 nREPL サーバ（必須）
  ;; ----------------------------------------------------------------
  :nrepl
  {:extra-deps {nrepl/nrepl                   {:mvn/version "1.3.0"}
                cider/cider-nrepl             {:mvn/version "0.50.2"}
                refactor-nrepl/refactor-nrepl {:mvn/version "3.10.0"}}
   :main-opts  ["-m" "nrepl.cmdline"
                "--middleware" "[cider.nrepl/cider-middleware,refactor-nrepl.middleware/wrap-refactor]"
                "--interactive"]}

  ;; ----------------------------------------------------------------
  ;; :poly — Polylith CLI（必須）
  ;; ----------------------------------------------------------------
  :poly
  {:replace-deps
   {polyfy/polylith
    {:git/url   "https://github.com/polyfy/polylith"
     :git/sha   "c804c2c962e5e81c307dcd878f88f8b10ee43403"
     :deps/root "projects/poly"}}
   :main-opts ["-m" "polylith.clj.core.poly-cli.core"]}

  ;; ----------------------------------------------------------------
  ;; :lint — clj-kondo（必須）
  ;; ----------------------------------------------------------------
  :lint
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
   :main-opts    ["-m" "clj-kondo.main"
                  "--fail-level" "warning"
                  "--lint" "components" "bases" "development/src"]}

  ;; 初回セットアップで依存ライブラリの clj-kondo hook を取り込む場合、
  ;; tools.deps の :main-opts はシェル展開されないため、以下をシェルで実行する:
  ;;   clj -M:lint --copy-configs --dependencies --lint "$(clj -A:dev -Spath)"
  ;; BOOTSTRAP_GUIDE.md §2.9 参照。

  ;; ----------------------------------------------------------------
  ;; :format — cljfmt（必須）
  ;; ----------------------------------------------------------------
  :format
  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.13.0"}}
   :main-opts    ["-m" "cljfmt.main"]}

  ;; ----------------------------------------------------------------
  ;; :outdated — antq（必須、依存更新確認）
  ;;   :dev エイリアス + 各 brick の deps.edn を合わせたグラフ全体を走査
  ;; ----------------------------------------------------------------
  :outdated
  {:replace-deps {com.github.liquidz/antq {:mvn/version "2.11.1264"}}
   :main-opts    ["-m" "antq.core"]}

  ;; ----------------------------------------------------------------
  ;; :test — Polylith 新版（master）が deps.edn に要求する alias
  ;;   実際のテスト実行は `clj -M:poly test` / `clj -M:poly test :all` で行う。
  ;;   本 alias は Polylith の deps.edn 検証を通すためのプレースホルダで、
  ;;   :extra-paths は各 brick 作成後に追加（BOOTSTRAP_GUIDE.md §2.5）。
  ;; ----------------------------------------------------------------
  :test
  {:extra-paths []}

  ;; ----------------------------------------------------------------
  ;; :lint-splint — Splint（必須層、clj-kondo の補完）
  ;;   スタイル・イディオムレベルの linter。clj-kondo が構文・型・未使用変数を、
  ;;   Splint が「(= 0 x) → (zero? x)」等の Clojure イディオム違反を検知。
  ;;   機能重複はないため、完了条件（CLAUDE.md §5.5）で両方走らせる。
  ;; ----------------------------------------------------------------
  :lint-splint
  {:replace-deps {io.github.noahtheduke/splint {:mvn/version "1.19.0"}}
   :main-opts    ["-m" "noahtheduke.splint"
                  "components" "bases" "development/src"]}

  ;; ----------------------------------------------------------------
  ;; :vulnerability-check — clj-watson（必須層、依存脆弱性スキャン）
  ;;   NIST NVD + GitHub Advisory Database を照合。完了条件（毎ターン）には
  ;;   入れず、週次 CI / release 前チェックで実行する。scripts/check-vulnerabilities.sh
  ;;   で包む。NVD API key の設定が推奨（詳細は scripts/check-vulnerabilities.sh）。
  ;; ----------------------------------------------------------------
  :vulnerability-check
  {:replace-deps {io.github.clj-holmes/clj-watson
                  {:git/tag "v6.0.1" :git/sha "b520351"}}
   :main-opts    ["-m" "clj-watson.cli" "scan"
                  "-p" "deps.edn"
                  "--fail-on-result"]}

  ;; ----------------------------------------------------------------
  ;; :repl-eval — 稼働中の nREPL に eval を送るクライアント（LLM 向け、CLAUDE.md §9）
  ;;
  ;; 本 alias は `.llm/scripts/repl_eval.clj` を exec-fn として呼び出す。
  ;; LLM は直接 clj を叩くのではなく shell wrapper `.llm/scripts/repl-eval.sh`
  ;; 経由で利用する（port 発見、stdin fallback、shell quoting 回避のため）。
  ;;
  ;; nREPL server 側は :nrepl alias で起動、client は .nrepl-port を自動発見して接続。
  ;; 永続 session (.nrepl-session) を再利用し、(reset) 後の段階探索・契約違反再現・
  ;; 構造化ログ観察・trace 等の stateful な REPL 駆動作業を支える。
  ;;
  ;; 使用例（shell wrapper 経由）:
  ;;   ./.llm/scripts/repl-eval.sh --expr '(+ 1 2)'
  ;;   ./.llm/scripts/repl-eval.sh --load-file components/user/src/poly/user/core.clj
  ;;   ./.llm/scripts/repl-eval.sh --ns poly.user.interface --expr '(create-user {:name "t"})'
  ;;   ./.llm/scripts/repl-eval.sh --interrupt
  ;; ----------------------------------------------------------------
  :repl-eval
  {:extra-deps  {nrepl/nrepl {:mvn/version "1.3.0"}}
   :extra-paths [".llm/scripts"]
   :exec-fn     repl-eval/run}

  ;; ----------------------------------------------------------------
  ;; :check-test-instrumentation — interface_test.clj の Malli fixture 検査
  ;;   shell wrapper `.llm/scripts/check-test-instrumentation.sh` から呼ばれる。
  ;;   `use-fixtures :once` が参照する defn fixture 本体に `malli.dev/start!`
  ;;   があるかを Clojure form として解析する。
  ;; ----------------------------------------------------------------
  :check-test-instrumentation
  {:extra-paths [".llm/scripts"]
   :exec-fn     check-test-instrumentation/run}

  ;; ----------------------------------------------------------------
  ;; :check-mode-scope — repo-context.edn に基づく mode/ownership 境界検査
  ;;   shell wrapper `.llm/scripts/check-mode-scope.sh` から呼ばれる。
  ;;   `.llm/repo-context.edn` を EDN として読み、template/project の
  ;;   所有権境界違反を検出する。
  ;; ----------------------------------------------------------------
  :check-mode-scope
  {:extra-paths [".llm/scripts"]
   :exec-fn     check-mode-scope/run}

  ;; ----------------------------------------------------------------
  ;; :check-archive-staleness — maintainer discussion staging entry 検査
  ;;   shell wrapper `.llm/scripts/check-archive-staleness.sh` から呼ばれる。
  ;; ----------------------------------------------------------------
  :check-archive-staleness
  {:extra-paths [".llm/scripts"]
   :exec-fn     check-archive-staleness/run}

  ;; ----------------------------------------------------------------
  ;; :gen-lib-catalog — 技術選定カタログから artifact を生成
  ;;   `;; lib-catalog` マーカ付き EDN block を抽出 → Malli 検証 →
  ;;   .llm/data/{libs.edn, deprecated-libs.patterns, forbidden-requires.patterns}
  ;;   を出力。shell スクリプト（check-deprecated-libs.sh /
  ;;   check-forbidden-requires.sh）が生成された .patterns を消費する。
  ;;   check-workspace-integrity.sh が再生成 + diff で drift を検知する。
  ;;
  ;; 実行例:
  ;;   clj -X:gen-lib-catalog
  ;;   clj -X:gen-lib-catalog :out-dir '"/tmp/out"'
  ;;
  ;; Malli は root :deps で既に利用可能のため :extra-deps は不要（-X 継承）。
  ;; ----------------------------------------------------------------
  :gen-lib-catalog
  {:extra-paths [".llm/scripts"]
   :exec-fn     gen-lib-catalog/generate}}}
