;; .llm/repo-context.edn — リポジトリのモード/所有権 manifest（SSOT）
;;
;; このファイルが repo-kind とパス所有権の唯一の情報源。
;; `.llm/scripts/session-briefing.sh` と `.llm/scripts/check-mode-scope.sh` が
;; 同一の manifest を読み、モード判定・所有権検査を行う。
;;
;; 設計原則:
;;   - SSOT: 所有権情報は本ファイルのみが保持する。banner や規約文書には enumerate せず、
;;     代わりに本ファイルへの pointer のみを置く（drift 防止）。
;;   - CLAUDE.md §1.2.1 機械化: 規律ではなく manifest + script で強制
;;   - CLAUDE.md §1.2.5 失敗早期検知: bootstrap 中途状態を briefing で早期提示し、
;;     完了条件の check で block
;;
;; モード語彙:
;;   正本は :repo-kind。文書上の "TEMPLATE MAINTENANCE" / "テンプレ保守" は
;;   :repo-kind :template を、"PROJECT" / "派生プロジェクト保守" は
;;   :repo-kind :project を指す。同義語を増やす時もこの 2 値へ写像する。
;;
;;   :template — このリポはテンプレートそのもの。テンプレ保守作業が行われる。
;;               派生プロジェクトの記録領域（:project-owned）には触れない。
;;   :project  — このリポは派生プロジェクト（bootstrap 後）。派生プロジェクト
;;               固有の決定・知見・コンテンツを記録する。
;;
;; 移行状態:
;;   :workspace-kind — :polylith | :plain-clojure | :unknown
;;     :plain-clojure は Polylith 化前の移行出発点を表す。完成状態ではない。
;;     本テンプレートを採用するなら Polylith 化へ進む。plain Clojure のまま
;;     薄く使う compatibility mode は定義しない。
;;   :adoption-mode — :retrofit | :partial | :complete
;;     :retrofit は既存 repo への導入直後。検査は警告中心で、人間確認後に
;;     :partial / :complete へ昇格する。
;;     :partial は strict template へ移行中。採用済み capability の gate は有効、
;;     未完了の required task は残っている状態。
;;     :complete は strict template 準拠完了。plain-clojure の :complete は無効。
;;     :complete には下記 6 capability の全採用が必要。
;;   :capabilities — 検出結果ではなく「この repo が採用済みとして扱う前提」。
;;     detect-repo-profile は候補を出すだけで、正本は人間承認後の本 manifest。
;;     値の意味:
;;       :deps-edn   — tools.deps/deps.edn を依存・alias 管理の正本として使う
;;       :clj-kondo  — clj-kondo 設定と lint gate を本テンプレート規律に含める
;;       :cljfmt     — cljfmt 設定と format gate を本テンプレート規律に含める
;;       :malli      — Malli 契約・instrumentation 規律を採用する
;;       :polylith   — Polylith workspace 構造・poly check/test gate を採用する
;;       :llm-guides — CLAUDE.md / .llm/guide / .llm/memory / .llm/scripts の
;;                     LLM 運用規律を採用する。ファイルの存在だけを意味しない。
;;   :template-source-revision / :applied-migrations — 派生 repo がどの template 由来で、
;;     どの migration を適用済みかを記録する。移行判定の正本は git 履歴ではなく
;;     .llm/template-version.edn と .llm/migrations/ の migration id。
;;
;; Bootstrap 時の transform:
;;   下流プロジェクトは bootstrap 完了時に本ファイルを以下のように書き換える:
;;     :repo-kind     :template → :project
;;     :template-name → :derived-from にリネーム
;;     :project-name "<myorg.myapp の実値>" を追加
;;   :ownership は保持（下流側でも SSOT として機能させる）。
;;   詳細手順: .llm/guide/BOOTSTRAP_GUIDE.md
;;
;; パス記法:
;;   - 末尾 `/` はディレクトリ全体
;;   - `*/**` は再帰 glob（subdir 配下のファイル全部）
;;   - `NNNN-*.md` は数字 4 桁プレフィックスのファイル名パターン

{:repo-kind     :template
 :template-name "clojure-polylith-llm-starter"
 :template-source-revision "543c6348414d491518416b1880ed4fe42c6d67ba"
 :migration-schema 1
 :applied-migrations #{"2026-05-13-001-retrofit-manifest"}
 :workspace-kind :polylith
 :adoption-mode :complete
 :capabilities #{:deps-edn
                 :clj-kondo
                 :cljfmt
                 :malli
                 :polylith
                 :llm-guides}

 :ownership
 {;; 派生プロジェクトが所有・編集する領域。テンプレ保守作業ではここを touch しない。
  ;; reference-repos.edn は template が空 scaffold を seed するが、:allowed-repos の
  ;; 内容は派生プロジェクトが所有する開発設定（reference-repos.sh で管理）。
  :project-owned
  #{".llm/memory/adr/NNNN-*.md"   ; NNNN-*.md パターン。README.md / template.md は除外
    ".llm/reference-repos.edn"    ; 参照 repo allowlist。内容は project 所有
    "components/*/**"              ; brick subdir 配下を再帰的に。top-level README は除外
    "bases/*/**"
    "projects/*/**"}

  ;; テンプレートが所有・保守する領域。派生プロジェクトでは原則編集しない。
  :template-owned
  #{"CLAUDE.md"
    ".llm/guide/"
    ".llm/scripts/"
    ".clj-kondo/polyguard/"
    ".llm/template-version.edn"
    ".llm/migrations/"
    ".llm/memory/archive/maintainer-discussions/"
    ".llm/repo-context.edn"
    ".llm/memory/adr/README.md"
    ".llm/memory/adr/template.md"
    "components/README.md"
    "bases/README.md"
    "projects/README.md"}

  ;; テンプレート repo だけが保持する領域。demo / benchmark / template
  ;; maintenance E2E のために使うが、派生プロジェクトの bootstrap 完了後は
  ;; 削除対象であり、project repo には残さない。
  :template-only
  #{".llm/template-only/"}

  ;; 同一ファイル内に二重所有が混在する場合。section 識別子で範囲を表す。
  ;; "§N" は markdown の level-2 見出し `## N.` から次の sibling `## M.`
  ;; 直前までを指す。###/#### などの深い見出しは親 §N に含まれる。
  ;; "§N+" は `## N.` 以降のすべて。level-2 の同番号重複は曖昧なので禁止。
  :section-scoped
  {".llm/memory/KNOWLEDGE.md" {:template ["§0"]      :project ["§1+"]}
   ".llm/memory/QUESTIONS.md" {:template ["§0" "§1"] :project ["§2+"]}
   "IDEA.md"                  {:template ["§0"]      :project ["§1+"]}
   "DESIGN.md"                {:template ["§0"]      :project ["§1+"]}}}}
