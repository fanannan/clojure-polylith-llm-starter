 overtone.core/definst {:message "overtone はプロダクション禁止（創作用途のみ、STACK_GUIDE §8.2）"}
 }

 ;; ---------------------------------------------------------------
 ;; consistent-alias — 本テンプレート推奨 alias カタログ
 ;; 一貫性の機械化。CODING_GUIDE.md §14.4 / §14.5 に準拠。
 ;; stack 採用で追加ライブラリを使う場合、ここに追記して統一する。
 ;; ---------------------------------------------------------------
 :consistent-alias
 {:aliases
 {clojure.string str
 clojure.set set
 clojure.edn edn
 clojure.walk walk
 clojure.pprint pprint
 clojure.core.async async
 malli.core m
 malli.generator mg
 malli.util mu
 malli.dev mdev
 malli.dev.pretty mpretty
 integrant.core ig
 integrant.repl ig-repl
 integrant.repl.state ig-state
 clojure.tools.namespace.repl tn}}}

 ;; ----------------------------------------------------------------
 ;; Malli の =>: lint-as により typed 関数として扱う
 ;; ----------------------------------------------------------------
 :lint-as
 {malli.core/=> clj-kondo.lint-as/def-catch-all}

 ;; ----------------------------------------------------------------
 ;; custom hook 登録
 ;; hook 本体は .clj-kondo/polyguard/hooks.clj（clj-kondo の classpath
 ;; root は .clj-kondo/ 直下）。
 ;; file-level 解析は scripts/check-*.sh（hook と script の役割分担は
 ;; MAINTAINERS_GUIDE.md §5.10 を参照）。
 ;; 各 finding の level は hook 側の reg-finding! で直接指定する（本 config
 ;; では :linters マップで上書きしない = hook 側の level が最終）。
 ;; ----------------------------------------------------------------
 :hooks
 {:analyze-call
 {clojure.core/defn polyguard.hooks/analyze-defn ; clojure.core/defn- polyguard.hooks/analyze-defn
 clojure.core/def polyguard.hooks/analyze-def ; clojure.core/try polyguard.hooks/analyze-try ; clojure.core.async/go polyguard.hooks/analyze-go ; malli.core/=> polyguard.hooks/analyze-m=> ;（近似）
 malli.core/validate polyguard.hooks/analyze-m-validate ;（近似）

 ;; forbidden-requires: STACK_GUIDE §8.1/§8.2 ライブラリの namespace 単位 require 検知
 ;; :discouraged-var は特定シンボル、本 hook は require 段階で検知する（両者併用）
 clojure.core/ns polyguard.forbidden-requires/analyze-ns
 clojure.core/require polyguard.forbidden-requires/analyze-require}}

 ;; ----------------------------------------------------------------
 ;; ns-groups + config-in-ns — brick 単位でのルール適用
 ;; ----------------------------------------------------------------
 ;; 有効化手順（最初のドメイン component と I/O component が揃ったら）:
 ;; 1. 下の :ns-groups のコメントを外し、<domain-component-name> と
 ;; <io-component-name> を実際の brick 名に置き換える（複数ある場合は追加）
 ;; 2. 下の :config-in-ns のコメントを外し、ドメイン層で禁止したい I/O 関数を列挙
 ;; 3. clj -M:lint が、ドメイン層 component のみ対象に I/O 呼び出しを error 化する
 ;;
 ;; :ns-groups は名前空間パターン → グループ名の対応表。
 ;; :config-in-ns は「グループ名 → そのグループに適用する追加ルール」の対応表。
 ;; この 2 つを連携させることで、特定 component だけ厳しいルールを課す。
 ;;
 ;; :ns-groups
 ;; [;; ドメイン系 component（I/O 禁止）
 ;; {:pattern "^myorg\\.myapp\\.<domain-component-name>\\..*" :name brick.domain}
 ;; ;; I/O 系 component / base
 ;; {:pattern "^myorg\\.myapp\\.<io-component-name>\\..*" :name brick.io}]

 ;; :config-in-ns
 ;; {brick.domain
 ;; ;; ドメイン層からの I/O 操作を error 化
 ;; {:linters
 ;; {:discouraged-var
 ;; {next.jdbc/get-datasource {:message "ドメイン層 I/O 禁止"}
 ;; hato.client/get {:message "ドメイン層 I/O 禁止"}
 ;; hato.client/post {:message "ドメイン層 I/O 禁止"}}}}}

 :output
 {:format :text
 :show-rule-name-in-message true
 :exclude-files ["target" "node_modules" ".cpcache" "classes"]}

 :skip-comments true}
