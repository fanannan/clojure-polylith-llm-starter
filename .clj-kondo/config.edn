;; .clj-kondo/config.edn
;;
;; 配布形態:
;;   - LLM 挙動を機械化する核心 linter は有効（必須層）
;;   - 採用 stack に応じた discouraged-var（I/O ライブラリ等）、ドメイン NS グループは
;;     デフォルト無効、該当 stack 採用時に有効化
;;   - clj-kondo の --copy-configs --dependencies で各ライブラリ提供 hook を取り込む

{:linters
 {;; --- 致命的: error 扱い（LLM の典型的な誤りを機械化） ---
  :unresolved-symbol            {:level :error}
  :unresolved-namespace         {:level :error}
  :unresolved-var               {:level :error}
  :type-mismatch                {:level :error}
  :invalid-arity                {:level :error}
  :unused-binding               {:level :error}
  :unused-private-var           {:level :error}
  :unused-namespace             {:level :error}
  :unused-import                {:level :error}
  :unused-referred-var          {:level :error}
  :duplicate-require            {:level :error}
  :duplicate-case-test-constant {:level :error}
  :duplicate-map-key            {:level :error}
  :duplicate-set-key            {:level :error}
  :missing-clause-in-try        {:level :error}
  :missing-body-in-when         {:level :error}
  :missing-else-branch          {:level :off}      ; if without else は多用する
  :uninitialized-var            {:level :error}
  :redundant-do                 {:level :error}
  :redundant-let                {:level :error}
  :redundant-fn-wrapper         {:level :error}
  :redefined-var                {:level :error}
  :inline-def                   {:level :error}
  :cond-else                    {:level :error}

  ;; --- 警告 ---
  :missing-docstring            {:level :warning}
  :shadowed-var                 {:level :warning}
  :reduce-without-init          {:level :warning}
  :loop-without-recur           {:level :warning}
  :line-length                  {:level :warning :max-line-length 120}

  ;; --- 禁止構文 ---
  :refer-all                    {:level :error :exclude [clojure.test]}
  :use                          {:level :error}
  :unsorted-required-namespaces {:level :warning}}

 ;; ----------------------------------------------------------------
 ;; Malli の =>: lint-as により typed 関数として扱う
 ;; ----------------------------------------------------------------
 :lint-as
 {malli.core/=> clj-kondo.lint-as/def-catch-all}

 ;; ----------------------------------------------------------------
 ;; discouraged-var — LLM の悪手を error で機械的に封じる
 ;; ----------------------------------------------------------------
 ;; 本節は `clj -M:lint` の対象（deps.edn :lint の --lint 引数: components, bases, development/src）
 ;; に対して適用される。projects/ 配下の build.clj 等はリント対象外のため、
 ;; build.clj での println 使用は CLAUDE.md §4.3 の例外条項により許容される。
 :linters/discouraged-var
 {;; --- 必須（全プロジェクト）---
  clojure.core/println       {:message "println はアプリケーションコードで禁止。tap> または構造化ログ（mulog/log）を使う。build.clj 等は例外（CLAUDE.md §4.3）"}
  clojure.core/prn           {:message "prn はアプリケーションコードで禁止。tap> または構造化ログ（mulog/log）を使う。build.clj 等は例外（CLAUDE.md §4.3）"}
  clojure.core/pr-str        {:message "デバッグ目的なら tap> を使う"}
  clojure.core/with-redefs   {:message "with-redefs は設計失敗サイン。依存注入を検討"}

  ;; --- I/O 系ライブラリを採用したら、対応する行をコメント解除して有効化 ---
  ;; ドメイン層での I/O 呼び出しを error 化したい場合に使う。
  ;; より厳密にドメイン層（特定 component）のみ禁止したい場合は、下の :ns-groups + :config-in-ns を使う。
  ;; next.jdbc/get-datasource   {:message "ドメイン層からの DB 操作禁止"}
  ;; hato.client/get            {:message "ドメイン層からの HTTP 呼び出し禁止"}
  ;; hato.client/post           {:message "ドメイン層からの HTTP 呼び出し禁止"}
  }

 ;; ----------------------------------------------------------------
 ;; ns-groups + config-in-ns — brick 単位でのルール適用
 ;; ----------------------------------------------------------------
 ;; 有効化手順（最初のドメイン component と I/O component が揃ったら）:
 ;;   1. 下の :ns-groups のコメントを外し、<domain-component-name> と
 ;;      <io-component-name> を実際の brick 名に置き換える（複数ある場合は追加）
 ;;   2. 下の :config-in-ns のコメントを外し、ドメイン層で禁止したい I/O 関数を列挙
 ;;   3. clj -M:lint が、ドメイン層 component のみ対象に I/O 呼び出しを error 化する
 ;;
 ;; :ns-groups は名前空間パターン → グループ名の対応表。
 ;; :config-in-ns は「グループ名 → そのグループに適用する追加ルール」の対応表。
 ;; この 2 つを連携させることで、特定 component だけ厳しいルールを課す。
 ;;
 ;; :ns-groups
 ;; [;; ドメイン系 component（I/O 禁止）
 ;;  {:pattern "^myorg\\.myapp\\.<domain-component-name>\\..*" :name brick.domain}
 ;;  ;; I/O 系 component / base
 ;;  {:pattern "^myorg\\.myapp\\.<io-component-name>\\..*"     :name brick.io}]

 ;; :config-in-ns
 ;; {brick.domain
 ;;  ;; ドメイン層からの I/O 操作を error 化
 ;;  {:linters/discouraged-var
 ;;   {next.jdbc/get-datasource {:message "ドメイン層 I/O 禁止"}
 ;;    hato.client/get          {:message "ドメイン層 I/O 禁止"}
 ;;    hato.client/post         {:message "ドメイン層 I/O 禁止"}}}}

 :output
 {:format :text
  :show-rule-name-in-message true
  :exclude-files ["target" "node_modules" ".cpcache" "classes"]}

 :skip-comments true}
